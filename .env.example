# Database
NUXT_DATABASE_URL=postgres://tattara:tattara@localhost:5432/tattara

# Sessions (nuxt-auth-utils) — at least 32 random characters
NUXT_SESSION_PASSWORD=
# HMAC key for OTP codes at rest — at least 32 random characters, different from the session password
NUXT_OTP_SECRET=
# HMAC key for opted-out phone numbers (STOP) — at least 32 random characters; never change it once set
NUXT_PHONE_HASH_SECRET=

# SMS
NUXT_SMS_PROVIDER=fake          # fake | termii
NUXT_SMS_API_KEY=
NUXT_SMS_SENDER_ID=
NUXT_SMS_BASE_URL=              # termii: account-specific base URL from the Termii dashboard
NUXT_SMS_WEBHOOK_SECRET=        # signs delivery reports and replies (Termii: X-Termii-Signature); blank = webhook off
NUXT_SMS_REPLY_NUMBER=          # two-way number supporters reply STOP to (from Termii); blank = "tell your PU lead"

# Public
NUXT_PUBLIC_APP_VERSION=0.0.0
# Base URL used in SMS links (invites)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_GPS_FLAG_METERS=3000
# Organisation named in the consent script read to supporters (blank = "the party")
NUXT_PUBLIC_ORG_NAME=
# Minutes of inactivity before the app asks for the PIN again (SECURITY_PRIVACY §7: 5)
NUXT_PUBLIC_LOCK_IDLE_MINUTES=5
