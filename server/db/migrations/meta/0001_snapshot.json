      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "policies": {},
      "checkConstraints": {
        "units_code_matches_level": {
          "name": "units_code_matches_level",
          "value": "coalesce(case \"units\".\"level\"\n    when 'state' then \"units\".\"code\" ~ '^[0-9]{2}$' and \"units\".\"parent_code\" is null\n    when 'lga' then \"units\".\"code\" ~ '^[0-9]{2}/[0-9]{2}$' and \"units\".\"parent_code\" is not distinct from left(\"units\".\"code\", 2)\n    when 'ward' then \"units\".\"code\" ~ '^[0-9]{2}/[0-9]{2}/[0-9]{2}$' and \"units\".\"parent_code\" is not distinct from left(\"units\".\"code\", 5)\n    when 'pu' then \"units\".\"code\" ~ '^[0-9]{2}/[0-9]{2}/[0-9]{2}/[0-9]{3}$' and \"units\".\"parent_code\" is not distinct from left(\"units\".\"code\", 8)\n  end, false)"
        },
        "units_name_not_blank": {
          "name": "units_name_not_blank",
          "value": "length(trim(\"units\".\"name\")) > 0"
        },
        "units_registered_voters_non_negative": {
          "name": "units_registered_voters_non_negative",
          "value": "\"units\".\"registered_voters\" is null or \"units\".\"registered_voters\" >= 0"
        }
